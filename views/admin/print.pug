doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Ceremony Attendee List - Print
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Jost:wght@300;400;500&display=swap")
    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Jost', sans-serif; color: #1a1a1a; background: #fff; padding: 0; }
      .print-page { max-width: 900px; margin: 0 auto; padding: 40px 30px; }
      .print-header { text-align: center; margin-bottom: 36px; padding-bottom: 24px; border-bottom: 2px solid #1a1a1a; }
      .print-header__ornament { color: #b08b5b; font-size: 18px; letter-spacing: 12px; margin-bottom: 12px; }
      .print-header__title { font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; }
      .print-header__subtitle { font-size: 13px; font-weight: 300; color: #666; margin-top: 6px; letter-spacing: 2px; text-transform: uppercase; }
      .print-meta { display: flex; justify-content: space-between; margin-bottom: 24px; font-size: 12px; color: #666; }
      .print-meta strong { color: #1a1a1a; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      thead tr { background: #1a1a1a; color: #fff; }
      thead th { padding: 10px 12px; text-align: left; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; font-size: 11px; }
      tbody tr { border-bottom: 1px solid #e8e8e8; }
      tbody tr:nth-child(even) { background: #fafafa; }
      tbody td { padding: 10px 12px; vertical-align: middle; }
      .td-none { color: #aaa; font-style: italic; }
      .badge { display: inline-block; background: #f0e6d3; color: #7a5c2e; padding: 2px 8px; border-radius: 20px; font-size: 11px; }
      .print-footer { margin-top: 32px; padding-top: 20px; border-top: 1px solid #ddd; display: flex; justify-content: space-between; font-size: 11px; color: #999; }
      .no-print { margin-bottom: 24px; display: flex; gap: 12px; }
      .btn-print { padding: 10px 24px; background: #1a1a1a; color: #fff; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 14px; letter-spacing: 1px; }
      .btn-back { padding: 10px 24px; background: transparent; color: #1a1a1a; border: 1px solid #1a1a1a; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 14px; letter-spacing: 1px; text-decoration: none; display: inline-block; }
      @media print {
        .no-print { display: none !important; }
        body { padding: 0; }
        .print-page { padding: 20px; }
      }
  body
    .print-page
      .no-print
        button.btn-print(onclick="window.print()") 🖨 Print Now
        a.btn-back(href="/admin/dashboard") ← Back to Dashboard

      .print-header
        .print-header__ornament ✦ ——— ✦
        h1.print-header__title Ceremony Attendance List
        p.print-header__subtitle Official Confirmed Attendees

      .print-meta
        div
          | Total Attendees:&nbsp;
          strong= totalCount
        div
          | Printed:&nbsp;
          strong= printDate

      table
        thead
          tr
            th No.
            th First Name
            th Last Name
            th Child's Name
            th Phone Number
            th Date Confirmed
        tbody
          if attendees.length > 0
            each attendee, index in attendees
              tr
                td= index + 1
                td= attendee.firstName
                td= attendee.lastName
                td
                  if attendee.childName
                    span.badge= attendee.childName
                  else
                    span.td-none —
                td= attendee.phoneNumber
                td= new Date(attendee.submittedAt).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })
          else
            tr
              td(colspan="6" style="text-align:center; padding: 30px; color:#999;") No attendees found.

      .print-footer
        span Ceremony RSVP System
        span Confidential — For Internal Use Only
